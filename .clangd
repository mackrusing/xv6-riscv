Diagnostics:
  UnusedIncludes: Strict
  MissingIncludes: Strict
  Includes:
    AnalyzeAngledIncludes: true
---
If:
  PathExclude: tools/.*
CompileFlags:
  Add:
    - --target=riscv64-unknown-elf
  Remove:
    - -fno-pie
    - -no-pie
    - -nopie
Diagnostics:
  Includes:
    IgnoreHeader:
      - string\.h
      - strings\.h
      - math\.h
      - stdlib\.h
      - stdio\.h
---
If:
  PathMatch: src/include/abi/syscalls\.def
Diagnostics:
  MissingIncludes: None
CompileFlags:
  Add:
    - -xc
    - -includeabi/stat.h
    - -DSYSCALL(num,name,stub,ret,params)=ret stub params;
---
If:
  PathMatch: src/kernel/include/kernel/syscall\.h
CompileFlags:
  Add:
    - -includeabi/types.h
